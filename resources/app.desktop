[Desktop Entry]
Name=Cosmic Ext Applet Statline
Comment=Minimal system monitor applet for the COSMIC Desktop
Type=Application
Icon=com.github.gozsunday.statline
Exec=cosmic-ext-applet-statline %F
Terminal=false
StartupNotify=true
Categories=COSMIC
Keywords=COSMIC
NoDisplay=true
X-CosmicApplet=true
X-CosmicHoverPopup=Auto
MimeType=
